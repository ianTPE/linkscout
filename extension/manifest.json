{
  "manifest_version": 3,
  "name": "LinkScout",
  "version": "0.1.0",
  "description": "Scores search results before you click: relevance, depth, category, and the key passage.",
  "permissions": ["storage"],
  "host_permissions": ["https://*.workers.dev/*", "http://localhost:8787/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://www.google.com/search*",
        "https://www.bing.com/search*",
        "https://duckduckgo.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
