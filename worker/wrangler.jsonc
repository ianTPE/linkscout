{
  "name": "linkscout-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"]
  // All config comes from secrets (`wrangler secret bulk`), or worker/.dev.vars locally:
  //   CF_ACCOUNT_ID     – Cloudflare account that runs Browser Run
  //   CF_API_TOKEN      – token with "Browser Rendering - Edit"
  //   TYPESAFE_API_KEY  – TypeSafe / Jev key
  //   LINKSCOUT_TOKEN   – shared secret the extension sends (use a random one in production)
  //   JINA_API_KEY      – optional, Jina Reader fallback (higher rate limit)
}
